@model AIChatApp.Models.ChatViewModel

<div class="container mt-4">

    <div class="row">

        <!-- Left Side - Chat Sessions -->
        <div class="col-md-3">

            <h4>Chats</h4>

            <a asp-controller="Chat"
               asp-action="NewChat"
               class="btn btn-primary mb-3">
                + New Chat
            </a>

            @foreach (var session in Model.ChatSessions)
            {
                <div class="d-flex justify-content-between align-items-center mb-2">

                    <a asp-controller="Chat"
                       asp-action="Index"
                       asp-route-sessionId="@session.Id"
                       class="flex-grow-1 @(Model.ChatSessionId == session.Id ? "fw-bold bg-light p-2" : "")">
                        @session.Title
                    </a>

                    <form asp-controller="Chat"
                          asp-action="DeleteSession"
                          method="post"
                          onsubmit="return confirm('Are you sure you want to delete this chat?');">

                        <input type="hidden" name="id" value="@session.Id" />

                        <button type="submit"
                                class="btn btn-sm btn-danger ms-2">
                            Delete
                        </button>

                    </form>

                </div>
            }

        </div>


        <!-- Right Side - Chat Area -->
        <div class="col-md-9">

            <h2>AI Chat</h2>

            <a asp-controller="Chat"
               asp-action="History"
               class="btn btn-secondary mb-3">
                Chat History
            </a>


            <!-- Message Form -->
            <form method="post" action="/Chat/Insert">

                <input type="hidden" asp-for="ChatSessionId" />

                <div class="mb-3">

                    <label class="form-label">
                        Ask something
                    </label>

                    <textarea name="UserMessage"
                              class="form-control"
                              rows="4"
                              placeholder="Type your question..."></textarea>

                    <span asp-validation-for="UserMessage"
                          class="text-danger"></span>

                </div>

                <button type="submit" class="btn btn-primary">
                    Send
                </button>

            </form>


            <!-- Current Response -->
            @if (Model != null && !string.IsNullOrEmpty(Model.UserMessage))
            {
                <div class="mt-4">

                    <div class="card mb-3">

                        <div class="card-header">
                            You
                        </div>

                        <div class="card-body">
                            @Model.UserMessage
                        </div>

                    </div>


                    <div class="card">

                        <div class="card-header">
                            AI
                        </div>

                        <div class="card-body">
                            @Model.AIResponse
                        </div>

                    </div>

                </div>
            }


            @if (Model.ChatHistory != null && Model.ChatHistory.Any())
            {
                <hr />

                <h4>Conversation</h4>

                @foreach (var chat in Model.ChatHistory)
                {
                    <!-- User Message -->
                    <div class="d-flex justify-content-end mb-3">
                        <div class="bg-primary text-white p-3 rounded"
                             style="max-width: 75%;">

                            <strong>You</strong>

                            <div class="mt-2">
                                @chat.UserMessage
                            </div>

                        </div>
                    </div>

                    <!-- AI Response -->
                    <div class="d-flex justify-content-start mb-3">
                        <div class="bg-light border p-3 rounded"
                             style="max-width: 75%;">

                            <strong>AI</strong>

                            <div class="mt-2">
                                @chat.AIResponse
                            </div>

                            <small class="text-muted">
                                @chat.CreatedDate.ToString("dd-MM-yyyy HH:mm")
                            </small>

                        </div>
                    </div>
                }
            }

        </div>

    </div>

</div>