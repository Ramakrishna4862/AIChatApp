@model List<AIChatApp.Models.ChatMessage>

<div class="container mt-4">

   
    <h2>Chat History</h2>
    <a asp-controller="Chat"
       asp-action="Index"
       class="btn btn-primary mb-3">
        New Chat
    </a>

    <form method="get" action="/Chat/History" class="mb-3">

        <div class="input-group">

            <input type="text"
                   name="searchText"
                   value="@ViewBag.SearchText"
                   class="form-control"
                   placeholder="Search conversations..." />

            <button type="submit" class="btn btn-primary">
                Search
            </button>

        </div>

    </form>

    @if (Model != null && Model.Any())
    {
        @foreach (var chat in Model)
        {
            <div class="card mb-3">

                <div class="card-header">
                    @chat.CreatedDate.ToString("dd-MM-yyyy HH:mm")
                </div>

                <div class="card-body">

                    <h6>You:</h6>
                    <p>@chat.UserMessage</p>

                    <h6>AI:</h6>
                    <p>@chat.AIResponse</p>

                    <form method="post"
                          action="/Chat/Delete"
                          onsubmit="return confirm('Are you sure you want to delete this conversation?');">

                        <input type="hidden"
                               name="id"
                               value="@chat.Id" />

                        <button type="submit" class="btn btn-danger btn-sm">
                            Delete
                        </button>

                    </form>

                </div>

            </div>
        }
    }
    else
    {
        <div class="alert alert-info">
            No chat history found.
        </div>
    }

    @if (ViewBag.TotalPages > 1)
    {
        <div class="mt-3">

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <a href="/Chat/History?searchText=@ViewBag.SearchText&page=@i"
                   class="btn @(i == ViewBag.CurrentPage ? "btn-primary" : "btn-outline-primary") me-1">

                    @i

                </a>
            }

        </div>
    }
    

</div>
