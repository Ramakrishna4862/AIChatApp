@model List<AIChatApp.Models.ChatMessage>

<h2>Chat History</h2>

<form asp-action="History" method="get" class="mb-3">
    <div class="input-group">
        <input type="text"
               name="searchText"
               value="@ViewBag.SearchText"
               class="form-control"
               placeholder="Search chat history..." />

        <button type="submit" class="btn btn-primary">
            Search
        </button>
    </div>
</form>

@if (Model.Count == 0)
{
    <p>No chat history found.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>User Message</th>
                <th>AI Response</th>
                <th>Date</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var chat in Model)
            {
                <tr>
                    <td>@chat.UserMessage</td>
                    <td>@chat.AIResponse</td>
                    <td>@chat.CreatedDate</td>

                    <td>
                        <form asp-action="Delete"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to delete this conversation?');">

                            <input type="hidden"
                                   name="id"
                                   value="@chat.Id" />

                            <button type="submit"
                                    class="btn btn-danger">
                                Delete
                            </button>

                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination">

            @if (ViewBag.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="History"
                       asp-route-page="@(ViewBag.CurrentPage - 1)"
                       asp-route-searchText="@ViewBag.SearchText">
                        Previous
                    </a>
                </li>
            }

            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="History"
                       asp-route-page="@i"
                       asp-route-searchText="@ViewBag.SearchText">
                        @i
                    </a>
                </li>
            }

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-action="History"
                       asp-route-page="@(ViewBag.CurrentPage + 1)"
                       asp-route-searchText="@ViewBag.SearchText">
                        Next
                    </a>
                </li>
            }

        </ul>
    </nav>
}